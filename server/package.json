{
  "name": "etappli-server",
  "version": "0.2.0",
  "description": "Etappli portfolio server: serves the app, data and images",
  "author": "Eta <eta92@hotmail.fr>",
  "scripts": {
    "debug": "nodemon --exec \"node --inspect=0.0.0.0:9229 --require ts-node/register app.ts\"",
    "start": "nodemon app.ts"
  },
  "nodemonConfig": {
    "watch": [
      "app.ts",
      "src",
      "data"
    ],
    "ignore": [
      "client/*",
      "node_modules"
    ],
    "ext": "ts,js,json",
    "exec": "ts-node app.ts"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 140
  },
  "dependencies": {
    "dotenv": "16.0.3",
    "express": "4.18.2",
    "geoip-lite": "1.4.7",
    "socket.io": "4.6.1"
  },
  "devDependencies": {
    "@types/express": "4.17.17",
    "@types/node": "18.15.11",
    "nodemon": "2.0.22",
    "prettier": "3.9.5",
    "ts-node": "10.9.2",
    "typescript": "5.0.4"
  }
}
